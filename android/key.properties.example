# Copy this file to android/key.properties (git ignores that file) and
# fill in your own values. NEVER commit key.properties or the .jks file.
#
# Keep the keystore OUTSIDE the project folder and back it up (e.g. a USB
# drive and a password manager). If this key is lost you can never publish
# an update to the same Google Play listing again.
#
# Windows paths: use forward slashes or double backslashes.
storeFile=E:/smartagro-keys/smartagro-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
